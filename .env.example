# SPDX-License-Identifier: Apache-2.0
# ─────────────────────────────────────────────────────────────────────────────
# NEXUS — environment variable reference
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL connection string (used by @nexus/db, apps/api, services/ingest)
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus

# Redis connection string (used by apps/api BullMQ queues, worker)
REDIS_URL=redis://localhost:6379

# Shared KV backend for the durable stores (research jobs, threads,
# notifications, usage/cost log, token budgets). Priority: 1) REDIS_URL above
# (same Redis, cross-pod safe), 2) Upstash REST below, 3) Cloudflare Workers KV
# on the CF edge, 4) in-process memory. The in-memory fallback is dev-only: it
# does not survive an API restart and is not shared across pods.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ── API Server ────────────────────────────────────────────────────────────────

# Auth rate limits (defaults shown; raise only for load-testing/troubleshooting)
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_RATE_WINDOW_MS=900000
# AUTH_REGISTER_RATE_LIMIT=5
# AUTH_REGISTER_RATE_WINDOW_MS=3600000
# AUTH_FORGOT_RATE_LIMIT=3
# AUTH_FORGOT_RATE_WINDOW_MS=3600000

# Fastify listen port (default: 3000)
PORT=3000

# Fastify listen host (default: 0.0.0.0)
HOST=0.0.0.0

# Comma-separated allowed CORS origins (default: *)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Log format: json | pretty (default: pretty in dev)
LOG_FORMAT=pretty

# Log file path (optional; if unset logs go to stdout only)
# LOG_FILE=/var/log/nexus/api.log

# ── OpenTelemetry ─────────────────────────────────────────────────────────────

# OTLP collector endpoint (e.g. http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name tag sent with every trace (default: nexus-runtime)
OTEL_SERVICE_NAME=nexus-runtime

# Sampler: always_on | always_off | traceidratio (default: always_on)
OTEL_TRACES_SAMPLER=always_on

# Sample ratio when using traceidratio (0.0–1.0, default: 1.0)
OTEL_TRACES_SAMPLER_ARG=1.0

# ── Authentication ────────────────────────────────────────────────────────────

# Master API key required in Authorization: Bearer <key> header for all routes
# Generated automatically by: make setup
NEXUS_API_KEY=change-me-dev-api-key

# Separate audit-log signing key (used by GET /audit/verify)
# Generated automatically by: make setup
NEXUS_AUDIT_KEY=change-me-dev-audit-key

# HS256 signing secret for user auth tokens (register/login/me).
# REQUIRED for sign-in — token issuance 500s without it. Generate: openssl rand -hex 32
NEXUS_JWT_SECRET=change-me-dev-jwt-secret

# JWT signing algorithm — "HS256" (shared secret, default) or "RS256" (key pair, §14.1).
# RS256 lets a downstream service verify tokens with the PUBLIC key only, never the
# signing secret. When RS256: set NEXUS_JWT_PRIVATE_KEY (issuance) and
# NEXUS_JWT_PUBLIC_KEY (verification). Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# NEXUS_JWT_ALG=HS256
# NEXUS_JWT_PRIVATE_KEY=
# NEXUS_JWT_PUBLIC_KEY=

# Ingest-only key for POST /ingest/* (can be same as NEXUS_API_KEY)
# Generated automatically by: make setup
NEXUS_INGEST_API_KEY=change-me-dev-ingest-key

# ── AI / LLM providers ────────────────────────────────────────────────────────

# Groq — used by council deliberation engine
GROQ_API_KEY=gsk_...

# Web search providers (§1.3) — checked in order: exa → brave → serper → tavily → searxng
EXA_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# Tavily — used by deep-research tasks
TAVILY_API_KEY=tvly-...

# Timeout bound (ms) for a single deep-research LLM call (synthesis, related
# questions). Default 90000. A hung provider must never leave a job `running`
# forever — jobs past the 5-minute liveness bound are recovered to `error` on read.
# RESEARCH_LLM_TIMEOUT_MS=90000

# Web pages, knowledge-base passages, webhook payloads and tool output are screened for
# instructions aimed at the model before they reach a prompt. redact (default) cuts them,
# flag only detects them, off skips the check.
# NEXUS_INJECTION_GUARD=redact
# A model also reads search sources, fetched pages, research snippets and routine payloads for
# reworded instructions the patterns miss, in one call per prompt: "provider/model", or
# "default" for the caller's own chain. Unset, only the patterns run.
# NEXUS_INJECTION_CLASSIFIER=groq/openai/gpt-oss-20b

# ── Ghoststack adapter ────────────────────────────────────────────────────────

# Base URL of the Ghoststack API (used by packages/adapters ghoststack adapter)
GHOSTSTACK_API_URL=http://localhost:4000

# Bearer token for Ghoststack API
GHOSTSTACK_API_TOKEN=change-me

# Ghoststack listen port when run embedded (default: 4000)
GHOSTSTACK_API_PORT=4000

# Path to Ghoststack data directory
GHOSTSTACK_DATA_DIR=.ghoststack

# Path to Python binary used by Ghoststack sub-processes
GHOSTSTACK_PYTHON=python3

# Path to system Python binary (fin-scrape runner)
PYTHON_BIN=python3

# Set to true to start in offline mode (simulated responses, no Python bridges needed).
# Flip to false only after installing bridge deps:
#   cd packages/runtime/src/bridges && pip install -r requirements.txt
GHOSTSTACK_OFFLINE_MODE=true

# Bootstrap showcase agents on first start
GHOSTSTACK_BOOTSTRAP_SHOWCASE=false

# Back up data directory on start
GHOSTSTACK_BACKUP_ON_START=false

# Floci internal endpoint (used by packages/runtime floci-client, default: http://localhost:4566)
FLOCI_ENDPOINT=http://localhost:4566

# Nexus API base URL — used by CLI client (default: http://localhost:3000)
NEXUS_API_URL=http://localhost:3000

# Floci (federated inference) URL — leave blank to disable
GHOSTSTACK_FLOCI_URL=

# Fall back to mock responses when Floci is unavailable
GHOSTSTACK_FLOCI_MOCK_FALLBACK=true

# Error if Floci response is not received (overrides mock fallback)
GHOSTSTACK_FLOCI_STRICT=false

# Enable MCP bridge proxy
GHOSTSTACK_MCP_BRIDGE=false

# MCP bridge listen port
GHOSTSTACK_MCP_PORT=4001

# ── Web frontend (Vite) ───────────────────────────────────────────────────────

# Base URL the web app uses to reach the API (proxy target in dev)
VITE_API_URL=http://localhost:3000

# Optional API key baked into the web app build
VITE_API_KEY=

# ── Docs site ─────────────────────────────────────────────────────────────────

# Algolia DocSearch (optional — docs site search)
# ALGOLIA_APP_ID=
# ALGOLIA_API_KEY=
# ALGOLIA_INDEX_NAME=nexus

# ── Signal worker ─────────────────────────────────────────────────────────────

# How often the signal worker polls for new signals (ms, default: 5000)
SIGNAL_WORKER_INTERVAL_MS=5000

# Number of signals processed per poll cycle (default: 10)
SIGNAL_WORKER_BATCH_SIZE=10

# ── Council deliberation ───────────────────────────────────────────────────────

# Model alias used by the council engine (default: nexus/smart → Groq 70b)
# Options: nexus/fast | nexus/smart | nexus/opus | nexus/sonnet | nexus/haiku
#          nexus/gemini | nexus/deepseek | nexus/mistral
COUNCIL_MODEL=nexus/smart

# Max output tokens per council archetype call (default: 4096)
COUNCIL_MAX_TOKENS=4096

# Minimum signal priority that triggers automatic council deliberation (default: high)
# Options: low | medium | high | critical
COUNCIL_MIN_PRIORITY=high

# Max council.deliberate jobs allowed per UTC day — fails open if Redis is down
# Resets automatically at midnight UTC via Redis EXPIREAT (default: 100)
COUNCIL_DAILY_BUDGET=100

# Additional LLM provider keys (council can use any configured provider)
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
# DOUBAO_API_KEY=...      # Volcengine Ark (ByteDance, China region)
# BYTEPLUS_API_KEY=...    # BytePlus ModelArk (Ark international region)
# HUNYUAN_API_KEY=...     # Tencent Hunyuan (OpenAI-compatible endpoint)
# SPARK_API_KEY=...       # iFlytek Spark (HTTP OpenAI-compatible endpoint)
# Azure OpenAI + Cloudflare + Baidu ERNIE are BYOK-only (composite creds stored as
# a JSON blob per user, not a single env key): Azure needs { apiKey, endpoint,
# deployment, apiVersion }; Cloudflare needs { apiKey, accountId }; Baidu ERNIE
# needs { clientId, clientSecret } (client-credentials OAuth → access token).
# Dify is also BYOK-only and app-scoped: the JSON blob is { apiKey, baseUrl?, user? }
# (apiKey authenticates one Dify app; baseUrl for self-hosted; user is the end-user tag).
# Alibaba Bailian/DashScope (Qwen) takes a plain key via OpenAI compatible-mode.
# XINFERENCE_BASE_URL=http://localhost:9997/v1   # self-hosted Xinference server
# REPLICATE_API_KEY=r8_...   # Replicate (predictions API, synchronous Prefer: wait)
# DASHSCOPE_API_KEY=sk-...   # Alibaba Bailian/DashScope (Qwen), OpenAI compatible-mode

# ── Graph extraction model ─────────────────────────────────────────────────
# Reading text into the knowledge graph costs two model calls per chunk. Name a cheap plain model as
# provider/model to run them on (a reasoning model can spend its tokens thinking and be cut off).
# NEXUS_EXTRACT_MODEL=mistral/mistral-small-latest

# ── Memory embedders (§1.3) ────────────────────────────────────────────────
# createBestEmbedder picks by NEXUS_EMBED_PROVIDER = ollama | openai | groq |
# voyage | jina | cohere | fixed (ollama wins when OLLAMA_BASE_URL is set and
# no override given; fixed is the deterministic 768-dim dev fallback). The
# pgvector schema is 768-dim — Groq nomic matches it natively; the others are
# validated per-model by the embedder (store dimensioning is on the operator).
# NEXUS_EMBED_PROVIDER=            # force a provider (see list above)
# VOYAGE_API_KEY=...               # voyage-3-lite (512d) / voyage-3 (1024d) / voyage-code-3 (2048d)
# JINA_API_KEY=...                 # jina-embeddings-v3 (1024d), optional task hint
# COHERE_API_KEY=...               # embed-v4.0 (1536d), input_type search_document/search_query

# ── Local sidecar router ────────────────────────────────────────────────────────
# Point at any self-hosted OpenAI-compatible router (default port :20128).
# When set, the alias `nexus/omni` routes through it, inheriting its whole provider
# catalog + fallback + compression. Configure the sidecar with your real keys
# (one OpenRouter key alone unlocks 200+ models).
# LOCAL_ROUTER_BASE_URL=http://localhost:20128/v1
# LOCAL_ROUTER_API_KEY=          # the sidecar's own key (blank if none)
# LOCAL_ROUTER_MODEL=auto        # default downstream model; override per-request

# ── Provider OAuth (@nexus/llm-oauth) ──────────────────────────────────────────
# Sanctioned third-party OAuth only. Register your own Google OAuth client
# (console.cloud.google.com → APIs & Services → Credentials),
# add the callback URL, and request the cloud-platform scope. An authed login
# yields a Vertex AI credential routed via the existing VertexDriver.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CLOUD_PROJECT=          # GCP project Vertex calls bill to
# GOOGLE_CLOUD_REGION=us-central1
#
# Azure OpenAI via Microsoft Entra ID (Azure AD). Register your own Entra app
# (portal.azure.com → App registrations), add the redirect URI, and grant it the
# Cognitive Services User role on the Azure OpenAI resource. An authed login yields
# an AAD bearer token routed via AzureOpenAIDriver (authMode:"aad"). All five must
# be set or the provider stays unregistered (catalog supported:false).
# AZURE_OAUTH_CLIENT_ID=
# AZURE_OAUTH_CLIENT_SECRET=
# AZURE_TENANT_ID=               # tenant GUID, or "organizations"/"common"
# AZURE_OPENAI_ENDPOINT=         # e.g. https://my-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=       # deployment name (routes the request)
# AZURE_OPENAI_API_VERSION=2024-10-21
# Dedicated master key (32 bytes, hex or base64) for the credential vault that
# encrypts OAuth tokens at rest. Per llm-oauth/SECURITY.md §3 this MUST be its
# own key — do NOT reuse NEXUS_SECRETS_KEY (blast-radius isolation). Generate:
#   openssl rand -hex 32
# NEXUS_OAUTH_VAULT_KEY=

# ── Search orchestrator ────────────────────────────────────────────────────────

# Chroma vector DB endpoint (enables ChromaSearchStrategy in search-orchestrator)
# Leave blank to fall back to mock strategies in dev
# CHROMA_URL=http://chroma:8000

# Chroma collection name (default: nexus)
# CHROMA_COLLECTION=nexus

# ── HuggingFace corpus publisher ──────────────────────────────────────────────

# HF Hub write-access token (enables HuggingFacePublisher for POST /corpus/flush)
# Generate at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# Target HuggingFace dataset repo (default: nexus/research)
# HF_REPO_ID=nexus/research

# ── Brief engine ───────────────────────────────────────────────────────────────

# HMAC-SHA256 signing key for BriefSigner (min 32 chars recommended)
# Generate: openssl rand -hex 32
# BRIEF_SIGNING_KEY=change-me-dev-signing-key

# ── Observation providers ──────────────────────────────────────────────────────

# LLM driver for structured observation extraction (format: provider/model)
# When set, LlmObservationProvider is used as primary; falls back to MockObservationProvider
# Example values: groq/openai/gpt-oss-120b | groq/llama-3.1-8b-instant | claude/claude-opus-4-5
# NEXUS_OBSERVATION_DRIVER=groq/openai/gpt-oss-120b

# ── Domain forecast ────────────────────────────────────────────────────────────

# OpenWeatherMap API key for OpenWeatherForecastHandler (separate from OPENWEATHER_API_KEY)
# When set, createProductionGateway() wires real weather forecasts for the "geo" domain
# OWM_API_KEY=...

# City used by OpenWeatherForecastHandler (default: London)
# OWM_CITY=London

# ── MCP OAuth ──────────────────────────────────────────────────────────────────

# OAuth 2.0 client credentials for McpOAuthProvider
# MCP_OAUTH_CLIENT_ID=your-client-id
# MCP_OAUTH_CLIENT_SECRET=your-client-secret

# OAuth token endpoint (used by McpServer.requireOAuth())
# MCP_OAUTH_TOKEN_URL=https://auth.example.com/oauth/token

# Space-separated OAuth scopes requested during token exchange
# MCP_OAUTH_SCOPES=mcp:tools mcp:resources

# ── SPECTRE (apps/spectre) ─────────────────────────────────────────────────────

# URL of the running Nexus API (apps/api). Leave empty to proxy via Vite dev server.
# VITE_API_URL=http://localhost:3000

# Nexus API key — same value as NEXUS_API_KEY above.
# VITE_API_KEY=your-nexus-api-key

# ── CODE-REPL / SANDBOX (packages/code-repl, /api/v1/code-repl) ──────────────────
# Sandboxed execution runs each request in a throwaway Docker container with a
# hard memory cap, no network, dropped capabilities and no-new-privileges.
# Requires a Docker daemon reachable from the API process (docker.sock). If Docker
# is unavailable the API falls back to a no-op mock executor.

# Hard memory cap per execution (default: 512m). Swap is disabled so this is a hard limit.
# REPL_MEMORY_LIMIT=512m

# CPU cap per execution in cores (default: 0.5)
# REPL_CPU_LIMIT=0.5

# Default wall-clock timeout per execution in ms (default: 10000, max 300000)
# REPL_TIMEOUT_MS=10000

# Max concurrent kernel sessions (default: 20)
# REPL_MAX_SESSIONS=20

# Container image for the "shell" language — arbitrary Linux commands (default: alpine:3.20).
# The shell language additionally runs as non-root (65534:65534) with a read-only
# rootfs and a 64MB writable /tmp tmpfs.
# SANDBOX_SHELL_IMAGE=alpine:3.20

# OCI runtime for every sandbox container (drive, agent tools, REPL); it must be registered
# with the Docker daemon. runsc runs them under gVisor; kata runs each one in its own microVM
# (Kata Containers, needs /dev/kvm and /dev/vhost-vsock; its Cloud Hypervisor configuration
# also boots under nested virtualization, where the QEMU one does not).
# SANDBOX_RUNTIME=runsc

# Plugins installed on this host (one directory per plugin, with manifest.json) run
# under deno via POST /api/plugins/:id/run. Defaults: <data dir>/plugins, deno on PATH.
# NEXUS_PLUGINS_DIR=/var/lib/nexus/plugins
# DENO_PATH=/usr/local/bin/deno

# ── TELEGRAM BOT (apps/api POST /bots/telegram/webhook, @nexus/bots) ─────────────
# Bot API token from @BotFather.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Secret token to register with setWebhook and verify on each request (recommended).
# Set the webhook with:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://<your-host>/bots/telegram/webhook" \
#     -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
# TELEGRAM_WEBHOOK_SECRET=a-long-random-string

# Bot @username (without @) — enables "mention" trigger mode in group chats.
# TELEGRAM_BOT_USERNAME=my_nexus_bot

# ── WORKER THROUGHPUT (apps/worker BullMQ concurrency) ───────────────────────────
# Concurrent jobs per priority queue. Defaults: high=4, medium=8, low=2.
# Scale up on larger nodes; scale down on constrained ones. Horizontal scaling:
# run multiple worker pods — BullMQ coordinates via Redis.
# WORKER_CONCURRENCY_HIGH=4
# WORKER_CONCURRENCY_MEDIUM=8
# WORKER_CONCURRENCY_LOW=2

# Daily drive backups: each changed drive becomes <dir>/<drive>/<time>.tar.gz,
# every .env left out, newest 7 kept. Unset means no backups.
# DRIVE_BACKUP_DIR=/var/backups/nexus-drives
# Or an S3-compatible bucket (takes precedence over the directory). For R2 the endpoint is
# https://<account>.r2.cloudflarestorage.com and the region "auto".
# DRIVE_BACKUP_S3_BUCKET=
# DRIVE_BACKUP_S3_ENDPOINT=
# DRIVE_BACKUP_S3_REGION=auto
# DRIVE_BACKUP_S3_ACCESS_KEY_ID=
# DRIVE_BACKUP_S3_SECRET_ACCESS_KEY=
# DRIVE_BACKUP_S3_PREFIX=drives/

# ── Token compression: heavy lossy mode (@nexus/llm-compress) ───────────────────
# Lossless tool-output compression (ANSI strip, line dedup, blank collapse) is
# always on where wired. HEAVY mode adds LLMLingua-2 — a BERT-class model that
# semantically drops low-signal tokens — and is OFF by default. Set to 1 to enable.
# Requires the optional peers (not installed by default):
#   pnpm add @atjsh/llmlingua-2 @huggingface/transformers @tensorflow/tfjs js-tiktoken
# First enabled run downloads ONNX model weights from Hugging Face: ~57 MB
# (TinyBERT) up to ~2.2 GB (XLM-RoBERTa) depending on the model. Opt-in only.
# NEXUS_LLMLINGUA=1

# ── Enterprise SSO: who an assertion may become ────────────────────────────────
# OIDC (NEXUS_OIDC_*) and SAML both link a verified identity to a Nexus account.
# By default they link only to an account that ALREADY EXISTS: an assertion
# proves the identity provider believes a claim, and nothing more. Creating an
# account for any address the provider will assert means that at a provider
# where anyone can sign up — or one where a user edits their own profile email —
# a stranger mints accounts, and where the address matches an existing user,
# takes that account over.
# Turn creation on only with BOTH of these, never one:
# NEXUS_SSO_AUTO_PROVISION=1
# NEXUS_SSO_ALLOWED_DOMAINS=example.com,subsidiary.example
# The older NEXUS_OIDC_AUTO_PROVISION / NEXUS_OIDC_ALLOWED_DOMAINS still work.
#
# Consumer sign-in (Google/GitHub via NEXUS_OAUTH_*) is the public sign-up path
# and is not gated by these — creating an account there is the point.

# ── Desktop app (apps/desktop) ─────────────────────────────────────────────────
# With none of these set, the desktop shell runs its own API against an embedded
# Postgres under the app's data directory and everything stays on the machine.
# NEXUS_DESKTOP_URL=http://127.0.0.1:5173   # load the renderer from here instead
# NEXUS_SYNC_URL=https://nexus.example      # deployment to sync with; unset = no sync
#
# Serving the built SPA from the API (what the desktop does, and any
# single-origin deployment): point this at apps/ui/build/client.
# NEXUS_SPA_DIR=/srv/nexus/ui
#
# DATABASE_URL also accepts an embedded Postgres, no server required:
# DATABASE_URL=pglite:///var/lib/nexus/postgres

# Folder that @file and @symbol mentions in chat may read. Unset disables them;
# never point it at a directory holding secrets on a shared server.
# NEXUS_WORKSPACE_DIR=/home/me/projects/my-app
