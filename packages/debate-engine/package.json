{
  "name": "@nexus/debate-engine",
  "version": "0.1.0",
  "description": "Converging multi-agent debate",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "debate",
    "multi-round",
    "quality-validation",
    "weighted-scoring",
    "llm",
    "adversarial"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
