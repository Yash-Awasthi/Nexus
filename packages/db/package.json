{
  "name": "@nexus/db",
  "version": "0.1.0",
  "private": false,
  "description": "Drizzle ORM schemas, migrations, and DB client for Postgres 16 + pgvector",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./package.json": "./package.json",
    "./embedded": "./src/embedded.ts",
    "./secret-crypto": "./src/secret-crypto.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-pgvector": "0.0.10",
    "@neondatabase/serverless": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.10",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./schema": {
        "import": "./dist/schema/index.js",
        "types": "./dist/schema/index.d.ts"
      },
      "./package.json": "./package.json",
      "./embedded": {
        "import": "./dist/embedded.js",
        "types": "./dist/embedded.d.ts"
      },
      "./secret-crypto": {
        "import": "./dist/secret-crypto.js",
        "types": "./dist/secret-crypto.d.ts"
      }
    }
  }
}
