{
  "name": "@nexus/contracts",
  "version": "0.0.0",
  "private": false,
  "description": "Generated OpenAPI + AsyncAPI clients and JSON Schema types",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage",
    "types:generate": "openapi-typescript ../../openapi.yaml --output src/generated/openapi.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
