{
  "name": "@nexus/llm-accounts",
  "version": "0.0.0",
  "private": false,
  "description": "Multi-account pool + tier ladder for LLM providers — N creds per provider with health/cooldown/quota state, tier-aware routing (sub→cheap→free), and a per-account circuit breaker.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
