{
  "name": "@nexus/runtime",
  "version": "0.1.0",
  "private": false,
  "description": "Execution kernel (ex-GhostStack): planning, governance, task execution, circuit breaker, queues",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@nexus/governance": "workspace:*",
    "@nexus/memory": "workspace:*",
    "@nexus/telemetry": "workspace:*",
    "bullmq": "catalog:",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
