{
  "name": "@nexus/mcp-openapi",
  "version": "0.0.0",
  "private": false,
  "description": "OpenAPI to MCP: every operation in a spec becomes an MCP tool with an executor",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexus/mcp-client": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
