{
  "name": "@nexus/mcp-openapi",
  "version": "0.0.0",
  "private": false,
  "description": "OpenAPI to MCP: every operation in a spec becomes an MCP tool with an executor",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist coverage",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexus/mcp-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
