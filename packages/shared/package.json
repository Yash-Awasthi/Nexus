{
  "name": "@nexus/shared",
  "version": "0.0.0",
  "private": false,
  "description": "Shared types, zod schemas, model registry, error classes",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vite-plus": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
