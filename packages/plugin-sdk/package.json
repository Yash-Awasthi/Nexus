{
  "name": "@nexus/plugin-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Adapter plugin SDK: defineAdapter, capability types, testing utilities",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./testing": {
        "import": "./dist/testing.js",
        "types": "./dist/testing.d.ts"
      }
    }
  }
}
