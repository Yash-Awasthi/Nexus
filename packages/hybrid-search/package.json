{
  "name": "@nexus/hybrid-search",
  "version": "0.0.0",
  "private": false,
  "description": "Hybrid search with RRF fusion — pgvector + BM25 merge via Reciprocal Rank Fusion + reranker",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nexus/mcp-client": "workspace:*",
    "@nexus/reranker": "workspace:*",
    "@nexus/retrieval": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
