{
  "name": "@nexus/council",
  "version": "0.1.0",
  "private": false,
  "description": "Multi-model deliberation engine (ex-Judica): providers, modes, presets, synthesis, guardrails",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./debate-engine": "./src/debate-engine/index.ts",
    "./best-of-n": "./src/best-of-n/index.ts",
    "./gauntlet": "./src/gauntlet/index.ts"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "test": "vp test run --passWithNoTests"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*",
    "@nexus/mcp-client": "workspace:*",
    "@nexus/shared": "workspace:*",
    "groq-sdk": "^1.6.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./debate-engine": {
        "import": "./dist/debate-engine/index.js",
        "types": "./dist/debate-engine/index.d.ts"
      },
      "./best-of-n": {
        "import": "./dist/best-of-n/index.js",
        "types": "./dist/best-of-n/index.d.ts"
      },
      "./gauntlet": {
        "import": "./dist/gauntlet/index.js",
        "types": "./dist/gauntlet/index.d.ts"
      }
    }
  }
}
