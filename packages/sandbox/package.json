{
  "name": "@nexus/sandbox",
  "version": "0.0.0",
  "private": false,
  "description": "Secure code execution sandbox — isolated subprocess runner for JS, TS, Python, Bash",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "clean": "rm -rf dist coverage",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nexus/plugin-sdk": "workspace:*",
    "aws4fetch": "^1.0.20"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
