{
  "name": "@nexus/doc-pipeline",
  "version": "0.0.0",
  "private": false,
  "description": "Document processing pipeline — extract, chunk, embed, store for PDF, HTML, text, and Markdown",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "dependencies": {
    "@nexus/plugin-sdk": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
