{
  "name": "@nexus/llm",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drivers": "./src/drivers/index.ts",
    "./router": "./src/router/index.ts",
    "./registry": "./src/registry/index.ts",
    "./budget": "./src/budget/index.ts",
    "./compress": "./src/compress/index.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*",
    "@toon-format/toon": "^2.3.1"
  },
  "optionalDependencies": {
    "@atjsh/llmlingua-2": "^2.0.3",
    "@huggingface/transformers": "^4.2.0",
    "@tensorflow/tfjs": "^4.22.0",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./drivers": {
        "import": "./dist/drivers/index.js",
        "types": "./dist/drivers/index.d.ts"
      },
      "./router": {
        "import": "./dist/router/index.js",
        "types": "./dist/router/index.d.ts"
      },
      "./registry": {
        "import": "./dist/registry/index.js",
        "types": "./dist/registry/index.d.ts"
      },
      "./budget": {
        "import": "./dist/budget/index.js",
        "types": "./dist/budget/index.d.ts"
      },
      "./compress": {
        "import": "./dist/compress/index.js",
        "types": "./dist/compress/index.d.ts"
      }
    }
  }
}
