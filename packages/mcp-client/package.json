{
  "name": "@nexus/mcp-client",
  "version": "0.0.0",
  "private": false,
  "description": "MCP client — connect Nexus TO other MCP servers as a consumer; list tools, call tools, read resources",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "clean": "rm -rf dist coverage",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
