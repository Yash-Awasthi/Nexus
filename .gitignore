# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
apps/desktop/resources/
.next/
out/

# Test / coverage
coverage/
.vitest/
playwright-report/
test-results/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Turbo
.turbo/

# Local runtime data stores (PersistentStore JSON files — dev state, not source)
apps/api/data/stores/

# Runtime data the API writes when NEXUS_DATA_DIR is unset (never source)
apps/api/data/
# Same, for a test run that leaves its embedded database under the package.
apps/api/.nexus/

# Embedded PGlite database (DATABASE_URL=pglite://.nexus/db)
# Ignore the contents, not the directory: git cannot re-include a file under an
# excluded directory, and the k6 baseline is evidence worth tracking.
.nexus/*
!.nexus/k6-baseline.txt

# Local runtime state under data/ (auth tokens, run ids — dev state, not source)
data/.*
data/bridge/

# Python
__pycache__/
*.py[cod]
*.so
.venv/
.venv-readiness/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Vendored Python runtime (embedded interpreter, dev convenience only)
apps/api/Python/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Misc
*.log
sbom.json
thepast-conv.txt

# Local resume notes (not shared)
PROGRESS.md

# Reference clones for porting (local only, never committed)
REF/

# Local Claude Code config & worktrees (not part of the project)
.claude/

# Local dev tooling (portable Redis etc.)
.local/

# Docusaurus build cache
.docusaurus/

# Local reference clones for inspiration — never commit these
inspiration/

# Local tooling marker, not project source.
.freebuff/
*.tsbuildinfo

# The workspace installs from the root pnpm-lock.yaml only.
**/package-lock.json

# Generated agent skill bundles
.agents/

# Subagent session IDs and exported transcripts, local only
.opencode/subagents/*.txt
