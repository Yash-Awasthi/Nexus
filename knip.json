{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/plugin-sdk": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/api": {
      "entry": [
        "src/runtime-server.ts",
        "src/migrate.ts",
        "src/grant-admin.ts",
        "scripts/*.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "apps/worker": {
      "entry": ["src/bridge.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/ui": {
      "entry": ["app/routes/**/*.tsx", "app/components/ui/*.tsx", "tests/**/*.{test,spec}.ts"],
      "project": ["app/**/*.{ts,tsx,css}", "tests/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/preload.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/runtime-cli.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },
  "ignoreDependencies": ["pino-pretty", "pyodide"],
  "ignoreBinaries": ["syft", "go", "gofmt", "where"],
  "ignoreExportsUsedInFile": true
}
