{
  "name": "@nexus/root",
  "private": true,
  "version": "0.0.0",
  "description": "Nexus — AI orchestration platform (monorepo root)",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && turbo run build",
    "build:desktop-api": "node scripts/build-desktop-api.mjs",
    "openapi:generate": "pnpm --filter @nexus/api openapi:generate",
    "openapi:check": "pnpm --filter @nexus/api openapi:check",
    "types:generate": "pnpm --filter @nexus/contracts types:generate",
    "types:check": "node scripts/check-generated-types.mjs",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @nexus/api dev",
    "dev:ui": "pnpm --filter @nexus/ui dev",
    "dev:spectre": "pnpm --filter @nexus/spectre dev",
    "board:build": "cd services/board && node -e \"require('fs').mkdirSync('bin',{recursive:true})\" && go build -o bin/vb.exe ./cmd/open-board && go build -o bin/mcp-bridge.exe ./cmd/mcp-bridge",
    "board:serve": "cd services/board && .\\vb.exe serve --port 4100 --dir ../../.nexus/board --channel nexus",
    "board:test": "cd services/board && go test -race ./...",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "test": "turbo run test",
    "typecheck": "pnpm --filter @nexus/ui exec react-router typegen && tsc -b --noEmit",
    "test:e2e": "playwright test",
    "check:offline": "node scripts/offline-check.mjs",
    "baseline": "node scripts/baseline.mjs --write",
    "baseline:check": "node scripts/baseline.mjs --check",
    "cli:parity": "node scripts/cli-parity.mjs",
    "tsconfig:sync": "node scripts/tsconfig-refs.mjs",
    "check:online": "node scripts/online-check.mjs",
    "format": "vp fmt \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "vp fmt --check \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "generate": "node scripts/generate-clients.ts",
    "scaffold:adapter": "node scripts/scaffold.ts adapter",
    "scaffold:driver": "node scripts/scaffold.ts driver",
    "scaffold:feed": "node scripts/scaffold.ts feed",
    "db:migrate": "turbo run db:migrate --filter @nexus/db",
    "db:generate": "turbo run db:generate --filter @nexus/db",
    "check:headers": "node scripts/check-license-headers.ts",
    "check:docs": "node scripts/check-env-docs.mjs",
    "check:release": "node scripts/release/verify-wiring.mjs",
    "sbom": "syft . -o cyclonedx-json > sbom.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prune:knip": "pnpm --filter @nexus/ui exec react-router typegen && knip",
    "prepare": "husky",
    "desktop:dist": "pnpm --filter @nexus/ui build && pnpm --filter @nexus/desktop dist",
    "release:manifest": "node scripts/release/build-update-manifest.mjs",
    "release:verify": "node scripts/release/verify-artifacts.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "perf": "node scripts/perf-budget.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "boot:budget": "node scripts/api-boot-budget.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "rolldown": "^1.2.13",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  }
}
