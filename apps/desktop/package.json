{
  "name": "@nexus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus desktop shell: Electron main process, preload host bridge",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "electron dist/main.js",
    "dev": "tsc --project tsconfig.json && electron dist/main.js",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist coverage",
    "smoke": "node scripts/smoke.cjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
